# SOLO para pruebas automáticas. Usa un proyecto/base de DESARROLLO: los tests crean datos reales.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nova_test
DB_SSL=false
SUPABASE_URL=https://test.supabase.co
SUPABASE_ANON_KEY=test
SUPABASE_SERVICE_ROLE_KEY=test
# Secreto inventado: los tests firman sus propios tokens con él
SUPABASE_JWT_SECRET=secreto-de-pruebas-de-al-menos-32-caracteres
