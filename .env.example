NODE_ENV=development
PORT=3000

# Supabase > Connect > Transaction pooler (puerto 6543). Reemplaza [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_SSL=true

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Solo si tu proyecto usa el JWT secret legado (HS256). Con claves asimétricas déjalo vacío.
SUPABASE_JWT_SECRET=

# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173
